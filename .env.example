# prototype | mvp
APP_MODE=prototype
# Supabase Postgres connection string. Leave empty to use the embedded local database.
DATABASE_URL=
# Public origin, used in share links and messages. Leave empty locally (derived from the request).
NEXT_PUBLIC_SITE_URL=

# Required in production
SESSION_SECRET=
ADMIN_PASSCODE=
LAB_PASSCODE=

# MVP1 only
# sms = Supabase phone auth | email = code by email (no SMS budget)
AUTH_METHOD=email
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated NGO invite codes (more can be created in /admin)
NGO_INVITE_CODES=
# Shared secret for the scheduled job endpoint
CRON_SECRET=
