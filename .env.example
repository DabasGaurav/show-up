# Copy to .env.local. Everything can stay empty on your own computer:
# the site then uses a local database and prints emails instead of sending them.

# Hosted Postgres connection string. Empty = local database in .data/
DATABASE_URL=
# Public address, used in links inside emails. Empty locally.
NEXT_PUBLIC_SITE_URL=

# Needed on the live site only. Never commit real values.
SESSION_SECRET=
ADMIN_PASSCODE=
CRON_SECRET=

# Email: a Gmail account (sends to anyone) or Resend. Gmail is used first when set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=

# Comma-separated test accounts that sign in without an email link.
TEST_LOGINS=
